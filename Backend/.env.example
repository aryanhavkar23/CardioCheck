# CardioCheck Backend Configuration
ENV=development
DEBUG=True
APP_PORT=8000
APP_HOST=0.0.0.0

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///./cardiocheck.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/cardiocheck

# Security & JWT Auth
JWT_SECRET_KEY=cardiocheck-super-secret-development-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Machine Learning Model Artifacts
MODEL_DIR=Models
LOGISTIC_REGRESSION_MODEL_PATH=Models/logistic_regression_model.pkl
SCALER_PATH=Models/heart_disease_scaler.pkl
RANDOM_FOREST_MODEL_PATH=Models/random_forest_model.pkl

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
